{
  "expo": {
    "name": "Gastos",
    "slug": "gastos",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gastos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.eduardomaytorena.gastos"
    },
    "android": {
      "package": "mx.eduardomaytorena.gastos",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos de recibos para leer el monto y datos de compra.",
          "cameraPermission": "Permite tomar fotos de recibos para leer el monto y datos de compra."
        }
      ]
    ]
  }
}
